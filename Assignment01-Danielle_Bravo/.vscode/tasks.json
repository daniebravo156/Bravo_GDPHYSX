{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "Build OpenGL Assignment",
            "command": "g++",
            "args": [
                "-g",
                "${workspaceFolder}/src/main.cpp",
                "${workspaceFolder}/src/Particle.cpp",
                "${workspaceFolder}/src/ModelLoader.cpp",
                "${workspaceFolder}/glad.c",
                "-I${workspaceFolder}/include",
                "-I${workspaceFolder}/src/headers",
                "-L${workspaceFolder}/lib",
                "-lglfw3",
                "-lopengl32",
                "-lgdi32",
                "-o",
                "${workspaceFolder}/BaseProjectDemo-Bravo.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Compiler task for OpenGL"
        }
    ]
}